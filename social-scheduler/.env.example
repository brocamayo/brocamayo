# Copy to .env and fill in. Never commit the real .env.
# These are your developer-app keys - one set covers all of your accounts.

# Instagram (Meta developer app -> Instagram -> API setup with Instagram login)
INSTAGRAM_APP_SECRET=
# Facebook Pages (Meta app -> App settings -> Basic); also used by the older Instagram route:
META_APP_ID=
META_APP_SECRET=

# TikTok (developers.tiktok.com app with Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X (developer.x.com app, OAuth 2.0 client)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional: TikTok inbox drafts can't carry a caption, so each draft's caption is sent to
# your phone through the free ntfy app (ntfy.sh). Pick a long random topic name and
# subscribe to it in the app.
NTFY_TOPIC=

# Optional: Slack / Discord / Teams incoming webhook for a summary after each run
NOTIFY_WEBHOOK_URL=
