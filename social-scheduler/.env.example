# Copy to .env and fill in. Never commit the real .env.

# Instagram (Meta developer app + Instagram professional account)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_USER_ID=            # optional - `socialq auth instagram` finds it for you
INSTAGRAM_ACCESS_TOKEN=       # optional - leave blank if you use `socialq auth instagram`

# TikTok (developers.tiktok.com app with Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional: Slack / Discord / Teams incoming webhook for a summary after each run
NOTIFY_WEBHOOK_URL=
